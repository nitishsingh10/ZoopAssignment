# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set this to your deployed frontend URL in production
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# OPTION A: Neon DB (production) — single connection string
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# OPTION B: Local PostgreSQL (development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zoop_agents
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── Redis ─────────────────────────────────────────────────────────────────────
# OPTION A: Upstash (production) — single URL
# REDIS_URL=rediss://default:your_token@your-endpoint.upstash.io:6379

# OPTION B: Local Redis (development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Cache TTL ─────────────────────────────────────────────────────────────────
CACHE_TTL=300
